{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$extensions": {
    "page-theme": {
      "defaultScheme": "light"
    }
  },
  "color": {
    "neutral": {
      "$extensions": { "page-theme": { "scale": { "mode": "ordinal", "measure": "oklch-l" } } },
      "1": {
        "$type": "color",
        "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff" },
        "$extensions": { "page-theme": { "observed": true, "confidence": "high", "source": "measured", "measured": { "oklchL": 1 } } }
      },
      "2": {
        "$type": "color",
        "$value": { "colorSpace": "srgb", "components": [0.9569, 0.9647, 0.9725], "hex": "#f4f6f8" },
        "$extensions": { "page-theme": { "observed": true, "confidence": "high", "source": "measured", "measured": { "oklchL": 0.975 } } }
      },
      "3": {
        "$type": "color",
        "$value": { "colorSpace": "srgb", "components": [0.8667, 0.8902, 0.9176], "hex": "#dde3ea" },
        "$extensions": { "page-theme": { "observed": true, "confidence": "high", "source": "measured", "measured": { "oklchL": 0.912 } } }
      },
      "4": {
        "$type": "color",
        "$value": { "colorSpace": "srgb", "components": [0.3529, 0.3922, 0.4471], "hex": "#5a6472" },
        "$extensions": { "page-theme": { "observed": true, "confidence": "high", "source": "measured", "measured": { "oklchL": 0.492 } } }
      },
      "5": {
        "$type": "color",
        "$value": { "colorSpace": "srgb", "components": [0.0863, 0.1255, 0.1725], "hex": "#16202c" },
        "$extensions": { "page-theme": { "observed": true, "confidence": "high", "source": "measured", "measured": { "oklchL": 0.242 } } }
      }
    },
    "teal": {
      "$extensions": { "page-theme": { "scale": { "mode": "ordinal", "measure": "oklch-l" } } },
      "1": {
        "$type": "color",
        "$value": { "colorSpace": "srgb", "components": [0.0784, 0.6275, 0.5608], "hex": "#14a08f" },
        "$extensions": { "page-theme": { "observed": true, "confidence": "high", "source": "measured", "measured": { "oklchL": 0.63 } } }
      },
      "2": {
        "$type": "color",
        "$value": { "colorSpace": "srgb", "components": [0.0588, 0.4784, 0.4235], "hex": "#0f7a6c" },
        "$extensions": { "page-theme": { "observed": true, "confidence": "high", "source": "measured", "measured": { "oklchL": 0.501 } } }
      }
    },
    "indigo": {
      "$extensions": { "page-theme": { "scale": { "mode": "ordinal", "measure": "oklch-l" } } },
      "1": {
        "$type": "color",
        "$value": { "colorSpace": "srgb", "components": [0.1686, 0.2275, 0.5608], "hex": "#2b3a8f" },
        "$extensions": { "page-theme": { "observed": true, "confidence": "high", "source": "measured", "measured": { "oklchL": 0.371 } } }
      }
    },
    "orange": {
      "$extensions": { "page-theme": { "scale": { "mode": "ordinal", "measure": "oklch-l" } } },
      "1": {
        "$type": "color",
        "$value": { "colorSpace": "srgb", "components": [0.851, 0.4667, 0.0235], "hex": "#d97706" },
        "$extensions": { "page-theme": { "observed": false, "confidence": "low", "source": "supplied", "measured": { "oklchL": 0.658 }, "officialName": "--lyl-color-accent-amber", "dontId": "design-dont-declared-accent-amber" } }
      }
    },
    "primary": {
      "$root": {
        "$type": "color",
        "$value": "{color.teal.2}",
        "$extensions": { "page-theme": { "observed": true, "confidence": "medium", "source": "measured", "observedHex": "#0f7a6c" } }
      },
      "hover": {
        "$type": "color",
        "$value": "{color.teal.1}",
        "$extensions": { "page-theme": { "observed": true, "confidence": "medium", "source": "measured", "observedHex": "#14a08f" } }
      }
    },
    "identity": {
      "$root": {
        "$type": "color",
        "$value": "{color.indigo.1}",
        "$extensions": { "page-theme": { "observed": true, "confidence": "medium", "source": "measured", "observedHex": "#2b3a8f" } }
      }
    },
    "accent": {
      "$root": {
        "$type": "color",
        "$value": "{color.orange.1}",
        "$extensions": { "page-theme": { "observed": false, "confidence": "low", "source": "supplied", "dontId": "design-dont-declared-accent-amber" } }
      }
    },
    "on": {
      "primary": {
        "$root": {
          "$type": "color",
          "$value": "{color.neutral.1}",
          "$extensions": { "page-theme": { "observed": true, "confidence": "medium", "source": "measured", "observedHex": "#ffffff" } }
        }
      },
      "surface": {
        "default": {
          "$root": {
            "$type": "color",
            "$value": "{color.neutral.5}",
            "$extensions": { "page-theme": { "observed": true, "confidence": "medium", "source": "measured", "observedHex": "#16202c" } }
          }
        },
        "muted": {
          "$root": {
            "$type": "color",
            "$value": "{color.neutral.5}",
            "$extensions": { "page-theme": { "observed": true, "confidence": "medium", "source": "measured", "observedHex": "#16202c" } }
          }
        }
      }
    },
    "text": {
      "default": {
        "$root": {
          "$type": "color",
          "$value": "{color.neutral.5}",
          "$extensions": { "page-theme": { "observed": true, "confidence": "high", "source": "measured", "observedHex": "#16202c" } }
        }
      },
      "muted": {
        "$root": {
          "$type": "color",
          "$value": "{color.neutral.4}",
          "$extensions": { "page-theme": { "observed": true, "confidence": "high", "source": "measured", "observedHex": "#5a6472" } }
        }
      },
      "link": {
        "$root": {
          "$type": "color",
          "$value": "{color.teal.2}",
          "$extensions": { "page-theme": { "observed": true, "confidence": "medium", "source": "measured", "observedHex": "#0f7a6c" } }
        }
      }
    },
    "surface": {
      "default": {
        "$root": {
          "$type": "color",
          "$value": "{color.neutral.1}",
          "$extensions": { "page-theme": { "observed": true, "confidence": "high", "source": "measured", "observedHex": "#ffffff" } }
        }
      },
      "muted": {
        "$root": {
          "$type": "color",
          "$value": "{color.neutral.2}",
          "$extensions": { "page-theme": { "observed": true, "confidence": "high", "source": "measured", "observedHex": "#f4f6f8" } }
        }
      }
    },
    "border": {
      "default": {
        "$root": {
          "$type": "color",
          "$value": "{color.neutral.3}",
          "$extensions": { "page-theme": { "observed": true, "confidence": "medium", "source": "measured", "observedHex": "#dde3ea" } }
        }
      }
    }
  },
  "dimension": {
    "fontSize": {
      "$extensions": { "page-theme": { "scale": { "mode": "ordinal", "measure": "px" } } },
      "1": {
        "$type": "dimension",
        "$value": { "value": 16, "unit": "px" },
        "$extensions": { "page-theme": { "observed": true, "confidence": "high", "source": "measured", "measured": { "px": 16 } } }
      },
      "2": {
        "$type": "dimension",
        "$value": { "value": 32, "unit": "px" },
        "$extensions": { "page-theme": { "observed": true, "confidence": "high", "source": "measured", "measured": { "px": 32 } } }
      }
    },
    "lineHeight": {
      "$extensions": { "page-theme": { "scale": { "mode": "ordinal", "measure": "px" } } },
      "1": {
        "$type": "dimension",
        "$value": { "value": 26, "unit": "px" },
        "$extensions": { "page-theme": { "observed": true, "confidence": "high", "source": "measured", "measured": { "px": 26 } } }
      },
      "2": {
        "$type": "dimension",
        "$value": { "value": 42, "unit": "px" },
        "$extensions": { "page-theme": { "observed": true, "confidence": "high", "source": "measured", "measured": { "px": 42 } } }
      }
    },
    "radius": {
      "$extensions": { "page-theme": { "scale": { "mode": "ordinal", "measure": "px" } } },
      "1": {
        "$type": "dimension",
        "$value": { "value": 6, "unit": "px" },
        "$extensions": { "page-theme": { "observed": true, "confidence": "high", "source": "measured", "measured": { "px": 6 } } }
      },
      "2": {
        "$type": "dimension",
        "$value": { "value": 12, "unit": "px" },
        "$extensions": { "page-theme": { "observed": true, "confidence": "high", "source": "measured", "measured": { "px": 12 } } }
      }
    },
    "spacing": {
      "$extensions": { "page-theme": { "scale": { "mode": "ordinal", "measure": "px" } } },
      "1": {
        "$type": "dimension",
        "$value": { "value": 16, "unit": "px" },
        "$extensions": { "page-theme": { "observed": true, "confidence": "high", "source": "measured", "measured": { "px": 16 } } }
      },
      "2": {
        "$type": "dimension",
        "$value": { "value": 24, "unit": "px" },
        "$extensions": { "page-theme": { "observed": true, "confidence": "high", "source": "measured", "measured": { "px": 24 } } }
      }
    }
  },
  "fontFamily": {
    "sans": {
      "$type": "fontFamily",
      "$value": ["system-ui", "PingFang SC", "Microsoft YaHei", "sans-serif"],
      "$extensions": { "page-theme": { "observed": true, "confidence": "high", "source": "measured" } }
    }
  },
  "fontWeight": {
    "regular": {
      "$type": "fontWeight",
      "$value": 400,
      "$extensions": { "page-theme": { "observed": true, "confidence": "high", "source": "measured" } }
    },
    "semibold": {
      "$type": "fontWeight",
      "$value": 600,
      "$extensions": { "page-theme": { "observed": true, "confidence": "high", "source": "measured" } }
    }
  },
  "typography": {
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{fontFamily.sans}",
        "fontSize": "{dimension.fontSize.1}",
        "fontWeight": "{fontWeight.regular}",
        "lineHeight": "{dimension.lineHeight.1}"
      },
      "$extensions": { "page-theme": { "observed": true, "confidence": "medium", "source": "measured" } }
    },
    "heading": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{fontFamily.sans}",
        "fontSize": "{dimension.fontSize.2}",
        "fontWeight": "{fontWeight.semibold}",
        "lineHeight": "{dimension.lineHeight.2}"
      },
      "$extensions": { "page-theme": { "observed": true, "confidence": "medium", "source": "measured" } }
    }
  },
  "shape": {
    "radius": {
      "control": {
        "$type": "dimension",
        "$value": "{dimension.radius.1}",
        "$extensions": { "page-theme": { "observed": true, "confidence": "medium", "source": "measured" } }
      },
      "container": {
        "$type": "dimension",
        "$value": "{dimension.radius.2}",
        "$extensions": { "page-theme": { "observed": true, "confidence": "medium", "source": "measured" } }
      }
    }
  },
  "component": {
    "button-primary": {
      "backgroundColor": {
        "$type": "color",
        "$value": "{color.primary.$root}",
        "$extensions": { "page-theme": { "observed": true, "confidence": "medium", "source": "measured", "observedHex": "#0f7a6c" } }
      },
      "textColor": {
        "$type": "color",
        "$value": "{color.on.primary.$root}",
        "$extensions": { "page-theme": { "observed": true, "confidence": "medium", "source": "measured", "observedHex": "#ffffff" } }
      },
      "rounded": {
        "$type": "dimension",
        "$value": "{shape.radius.control}",
        "$extensions": { "page-theme": { "observed": true, "confidence": "medium", "source": "measured", "measured": { "px": 6 } } }
      }
    },
    "button-primary-hover": {
      "backgroundColor": {
        "$type": "color",
        "$value": "{color.primary.hover}",
        "$extensions": { "page-theme": { "observed": true, "confidence": "medium", "source": "measured", "observedHex": "#14a08f" } }
      }
    }
  },
  "breakpoints": {
    "768": {
      "$type": "dimension",
      "$value": { "value": 768, "unit": "px" },
      "$extensions": { "page-theme": { "observed": true, "confidence": "high", "source": "measured", "breakpoint": { "aliases": [767, 768], "slots": ["mobile"] } } }
    },
    "1024": {
      "$type": "dimension",
      "$value": { "value": 1024, "unit": "px" },
      "$extensions": { "page-theme": { "observed": true, "confidence": "high", "source": "measured", "breakpoint": { "aliases": [1023, 1024], "slots": ["tablet"] } } }
    }
  }
}
