        "$type": "duration",
        "$value": "{duration.1}",
        "$extensions": { "page-theme": { "observed": true, "confidence": "medium", "source": "measured" } }
      }
    },
    "easing": {
      "control": {
        "$type": "cubicBezier",
        "$value": "{cubicBezier.ease}",
        "$extensions": { "page-theme": { "observed": true, "confidence": "medium", "source": "measured" } }
      }
    }
  },
  "shadow": {
    "1": {
      "$type": "shadow",
      "$value": {
        "color": { "colorSpace": "srgb", "components": [0.098, 0.098, 0.098], "alpha": 0.13, "hex": "#191919" },
        "offsetX": { "value": 0, "unit": "px" },
        "offsetY": { "value": 24, "unit": "px" },
        "blur": { "value": 64, "unit": "px" },
        "spread": { "value": 0, "unit": "px" }
      },
      "$extensions": { "page-theme": { "observed": true, "confidence": "medium", "source": "measured", "paintedRatio": 0.084256 } }
    }
  },
