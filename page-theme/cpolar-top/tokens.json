      "$extensions": {
        "page-theme": {
          "scale": {
            "mode": "declared",
            "declaredFrom": "--hm-radius-small|--hm-radius-medium|--hm-radius-large"
          }
        }
      },
      "small": {
        "$type": "dimension",
        "$value": { "value": 6, "unit": "px" },
        "$extensions": { "page-theme": { "observed": true, "confidence": "high", "source": "measured", "measured": { "px": 6 } } }
      },
      "medium": {
        "$type": "dimension",
        "$value": { "value": 12, "unit": "px" },
        "$extensions": { "page-theme": { "observed": true, "confidence": "high", "source": "measured", "measured": { "px": 12 } } }
      },
      "large": {
        "$type": "dimension",
        "$value": { "value": 24, "unit": "px" },
        "$extensions": { "page-theme": { "observed": false, "confidence": "low", "source": "autodetected", "measured": { "px": 24 } } }
