        "$type": "dimension",
        "$value": { "value": 12, "unit": "px" },
        "$extensions": { "page-theme": { "observed": true, "confidence": "high", "source": "measured", "measured": { "px": 12 } } }
      },
      "2": {
        "$type": "dimension",
        "$value": { "value": 14, "unit": "px" },
        "$extensions": { "page-theme": { "observed": true, "confidence": "high", "source": "measured", "measured": { "px": 14 } } }
      },
      "3": {
        "$type": "dimension",
        "$value": { "value": 28, "unit": "px" },
