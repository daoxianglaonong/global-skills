  "duration": {
    "1": {
      "$type": "duration",
      "$value": { "value": 200, "unit": "ms" },
      "$extensions": { "page-theme": { "observed": true, "confidence": "high", "source": "measured" } }
    }
  },
  "cubicBezier": {
    "ease": {
      "$type": "cubicBezier",
      "$value": [0.25, 0.1, 0.25, 1],
      "$extensions": { "page-theme": { "observed": true, "confidence": "medium", "source": "measured" } }
    }
  },
  "fontFamily": {
    "sans": {
      "$type": "fontFamily",
      "$value": ["Manrope", "-apple-system", "HuaweiSans", "Helvetica Neue", "Helvetica", "Arial", "PingFang SC", "Hiragino Sans GB", "STHeiti", "Microsoft YaHei", "Microsoft JhengHei", "SimSun", "sans-serif"],
      "$extensions": { "page-theme": { "observed": true, "confidence": "high", "source": "measured" } }
    },
    "mono": {
      "$type": "fontFamily",
      "$value": ["Consolas", "Menlo", "Fira Code", "monospace"],
      "$extensions": { "page-theme": { "observed": true, "confidence": "medium", "source": "measured" } }
    }
  },
  "fontWeight": {
    "regular": {
      "$type": "fontWeight",
      "$value": 400,
      "$extensions": { "page-theme": { "observed": true, "confidence": "high", "source": "measured" } }
