        "$extensions": { "page-theme": { "observed": true, "confidence": "medium", "source": "measured", "measured": { "px": 32 } } }
      },
      "border": {
        "$type": "border",
        "$value": {
          "color": "{color.text.default.$root}",
          "width": "{dimension.borderWidth.1}",
          "style": "solid"
        },
        "$extensions": { "page-theme": { "observed": true, "confidence": "medium", "source": "measured" } }
      }
    },
    "input-outline": {
      "backgroundColor": {
        "$type": "color",
        "$value": "{color.surface.default.$root}",
        "$extensions": { "page-theme": { "observed": true, "confidence": "medium", "source": "measured", "observedHex": "#ffffff" } }
      },
      "textColor": {
