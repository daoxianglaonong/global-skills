      "$extensions": { "page-theme": { "scale": { "mode": "ordinal", "measure": "px" } } },
      "1": {
        "$type": "dimension",
        "$value": { "value": 1, "unit": "px" },
        "$extensions": { "page-theme": { "observed": true, "confidence": "high", "source": "measured", "measured": { "px": 1 } } }
      }
    }
