        "$value": "{color.border.default.$root}",
        "$extensions": { "page-theme": { "observed": true, "confidence": "medium", "source": "measured", "observedHex": "#ebebeb", "lossy": true } }
      },
      "rounded": {
        "$type": "dimension",
        "$value": "{dimension.radius.1}",
        "$extensions": { "page-theme": { "observed": true, "confidence": "medium", "source": "measured", "measured": { "px": 20 } } }
