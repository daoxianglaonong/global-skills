      "container": {
        "$type": "dimension",
        "$value": "{dimension.radius.2}",
        "$extensions": { "page-theme": { "observed": true, "confidence": "medium", "source": "measured" } }
      }
    }
  },
  "motion": {
    "duration": {
      "control": {
        "$type": "duration",
        "$value": "{duration.1}",
        "$extensions": { "page-theme": { "observed": true, "confidence": "medium", "source": "measured" } }
      }
    },
    "easing": {
      "control": {
        "$type": "cubicBezier",
        "$value": "{cubicBezier.ease}",
        "$extensions": { "page-theme": { "observed": true, "confidence": "medium", "source": "measured" } }
      }
    }
  },
  "component": {
