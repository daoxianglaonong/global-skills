  "duration": {
    "1": {
      "$type": "duration",
      "$value": { "value": 200, "unit": "ms" },
      "$extensions": { "page-theme": { "observed": true, "confidence": "high", "source": "measured" } }
    }
  },
  "cubicBezier": {
    "ease": {
      "$type": "cubicBezier",
      "$value": [0.25, 0.1, 0.25, 1],
      "$extensions": { "page-theme": { "observed": true, "confidence": "high", "source": "measured" } }
    }
  },
  "fontFamily": {
    "sans": {
      "$type": "fontFamily",
      "$value": ["-apple-system", "HuaweiSans", "Helvetica Neue", "Helvetica", "Arial", "PingFang SC", "Hiragino Sans GB", "STHeiti", "Microsoft YaHei", "Microsoft JhengHei", "SimSun", "sans-serif"],
      "$extensions": { "page-theme": { "observed": true, "confidence": "high", "source": "measured" } }
    }
  },
  "fontWeight": {
    "regular": {
      "$type": "fontWeight",
      "$value": 400,
      "$extensions": { "page-theme": { "observed": true, "confidence": "high", "source": "measured" } }
    },
    "semibold": {
      "$type": "fontWeight",
      "$value": 600,
      "$extensions": { "page-theme": { "observed": true, "confidence": "high", "source": "measured" } }
    }
  },
  "typography": {
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{fontFamily.sans}",
        "fontSize": "{dimension.fontSize.2}",
        "fontWeight": "{fontWeight.regular}",
        "lineHeight": "{dimension.lineHeight.2}"
      },
      "$extensions": { "page-theme": { "observed": true, "confidence": "medium", "source": "measured" } }
    },
    "heading": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{fontFamily.sans}",
        "fontSize": "{dimension.fontSize.3}",
        "fontWeight": "{fontWeight.semibold}",
        "lineHeight": "{dimension.lineHeight.3}"
      },
      "$extensions": { "page-theme": { "observed": true, "confidence": "medium", "source": "measured" } }
    },
    "label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{fontFamily.sans}",
        "fontSize": "{dimension.fontSize.1}",
        "fontWeight": "{fontWeight.regular}",
        "lineHeight": "{dimension.lineHeight.1}"
      },
      "$extensions": { "page-theme": { "observed": true, "confidence": "medium", "source": "measured" } }
    }
  },
  "shape": {
    "radius": {
      "control": {
        "$type": "dimension",
        "$value": "{dimension.radius.3}",
        "$extensions": { "page-theme": { "observed": true, "confidence": "medium", "source": "measured" } }
