        "$value": { "value": 60, "unit": "px" },
        "$extensions": { "page-theme": { "observed": true, "confidence": "high", "source": "measured", "measured": { "px": 60 } } }
      }
    },
    "radius": {
      "$extensions": { "page-theme": { "scale": { "mode": "ordinal", "measure": "px", "guessedSystem": "candidate: site declares --por-radius-* ladder; ordinal keys used" } } },
      "1": {
        "$type": "dimension",
        "$value": { "value": 20, "unit": "px" },
        "$extensions": { "page-theme": { "observed": true, "confidence": "high", "source": "measured", "measured": { "px": 20 } } }
      },
      "2": {
        "$type": "dimension",
        "$value": { "value": 24, "unit": "px" },
        "$extensions": { "page-theme": { "observed": true, "confidence": "high", "source": "measured", "measured": { "px": 24 } } }
