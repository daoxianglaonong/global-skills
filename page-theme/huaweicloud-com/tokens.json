  "dimension": {
    "fontSize": {
      "$extensions": { "page-theme": { "scale": { "mode": "ordinal", "measure": "px", "guessedSystem": "candidate: site declares --por-font-size-{px}; ordinal keys used, not declared px names" } } },
      "1": {
        "$type": "dimension",
        "$value": { "value": 14, "unit": "px" },
        "$extensions": { "page-theme": { "observed": true, "confidence": "high", "source": "measured", "measured": { "px": 14 } } }
      },
      "2": {
        "$type": "dimension",
        "$value": { "value": 16, "unit": "px" },
        "$extensions": { "page-theme": { "observed": true, "confidence": "high", "source": "measured", "measured": { "px": 16 } } }
      },
      "3": {
        "$type": "dimension",
        "$value": { "value": 40, "unit": "px" },
        "$extensions": { "page-theme": { "observed": true, "confidence": "high", "source": "measured", "measured": { "px": 40 } } }
      }
    },
    "lineHeight": {
